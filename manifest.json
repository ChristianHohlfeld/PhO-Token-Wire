{
  "manifest_version": 3,
  "name": "PhoLine — PhO Token Wire",
  "version": "0.4.0",
  "minimum_chrome_version": "111",
  "description": "Bilingual PhO channel compression that intercepts fetch, XHR and WebSocket requests before provider tokenization.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openaipublic.blob.core.windows.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PhoLine",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "phen.js",
        "compressor.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "author": "Christian Heinrich Hohlfeld",
  "homepage_url": "https://christianhohlfeld.com/"
}
